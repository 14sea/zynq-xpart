# M7.0b host validation: build the portable C backprop and bit-exact check it
# against the numpy oracle (sim/oracle_train.py). The header is regenerated from
# the oracle so the two can never drift.
CC      ?= cc
CFLAGS  ?= -O2 -Wall -Wextra -std=c99
ORACLE   = ../../sim/oracle_train.py
HEADER   = m7_vectors.h

MNIST_ORACLE = ../../sim/oracle_mnist.py
MNIST_HEADER = m7_mnist_vectors.h

TINY_ORACLE = ../../sim/oracle_tiny.py
TINY_HEADER = m7_tiny_vectors.h

.PHONY: check check-hw mnist mnist-header tiny tiny-header header tu-golden clean
check: $(HEADER) train_xor.c
	$(CC) $(CFLAGS) -o /tmp/train_xor train_xor.c
	/tmp/train_xor

# M7.4: bit-exact check the MNIST-tile kernel vs the numpy oracle.
mnist: $(MNIST_HEADER) mnist_host.c m7_mnist_kernel.h
	$(CC) $(CFLAGS) -o /tmp/mnist_host mnist_host.c
	/tmp/mnist_host

# Regenerate the MNIST golden header from the oracle.
mnist-header:
	python3 $(MNIST_ORACLE) --dump-header $(MNIST_HEADER)

# M7.4-tiny: bit-exact check the small 16-4-2 kernel vs the numpy oracle.
tiny: $(TINY_HEADER) tiny_host.c m7_mnist_kernel.h
	$(CC) $(CFLAGS) -o /tmp/tiny_host tiny_host.c
	/tmp/tiny_host

# Regenerate the tiny golden header from the oracle.
tiny-header:
	python3 $(TINY_ORACLE) --dump-header $(TINY_HEADER)

# M7.2: validate the HW-trio split (train_unit modelled in C) bit-exact vs the oracle.
check-hw: $(HEADER) train_xor_hw.c m7_kernel_hw.h
	$(CC) $(CFLAGS) -o /tmp/train_xor_hw train_xor_hw.c
	/tmp/train_xor_hw

# Regenerate the golden header from the oracle (golden config defaults).
header:
	python3 $(ORACLE) --dump-header $(HEADER)

# M7.2: regenerate the train_unit per-sample golden trace for sim/tb_train.v.
tu-golden:
	python3 $(ORACLE) --dump-tu ../../sim/tb_train_golden --tu-samples 64

clean:
	rm -f /tmp/train_xor /tmp/train_xor_hw
